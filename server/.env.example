# server (render)

# render sets PORT for you, this is only the local fallback
PORT=3001

NODE_ENV=development

# mongodb atlas connection string
MONGO_URI=

# generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# google ai studio key
GEMINI_API_KEY=

# the single account allowed into /admin
ADMIN_EMAIL=your email

# comma separated list of browser origins allowed by cors.
# in production this must be your vercel url, no trailing slash.
CORS_ORIGINS=http://localhost:3000
